# Runtime
NODE_ENV=development
APP_ENV=local

# Public URLs
WEB_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000

# Browser-only (apps/web). Never put service-role keys here.
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=

# Supabase (server)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Redis / queues
REDIS_URL=redis://127.0.0.1:6379

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Session TTLs
EPHEMERAL_SESSION_TTL_SECONDS=1800
SESSION_MAX_LIFETIME_SECONDS=14400

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Geo / providers
GEO_PROVIDER=
GEO_API_KEY=

# Channels (shared)
# Keyed salt for pseudonymous channel identities. Min 32 chars.
# Raw phone numbers and provider session ids are HMAC'd with this before being
# used as a Redis key or a log field. Rotating it orphans in-flight ephemeral
# channel sessions, which is acceptable. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CHANNEL_IDENTITY_SALT=
CHANNEL_SESSION_TTL_SECONDS=1800

# WhatsApp — V1 transport is Baileys (WhatsApp Web multi-device), NOT the Meta
# Cloud API. There is no phone-number id, access token, or webhook verify token.
# The four WHATSAPP_* Cloud API variables below are retained only for a possible
# future migration and are unused by apps/whatsapp.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Shared HMAC secret for the gateway <-> API hop. Min 32 chars.
WHATSAPP_GATEWAY_SECRET=
# Redis slot holding the Baileys account session. One per environment, so
# staging and production never share a linked device.
WHATSAPP_AUTH_SLOT=default
# Device name shown in WhatsApp > Linked devices on the operator phone.
WHATSAPP_DEVICE_NAME=KKD

# USSD
USSD_PROVIDER=africastalking
USSD_API_KEY=
# Shared HMAC secret for the aggregator callback. Min 32 chars.
USSD_CALLBACK_SECRET=
USSD_SESSION_TTL_SECONDS=180

# Voice
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
VOICE_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Feature flags (true|false)
FEATURE_HEALTH_RECORDS=false
FEATURE_HEALTH_PROFILE=false
FEATURE_WHATSAPP=false
FEATURE_USSD=false
FEATURE_VOICE=false
FEATURE_MCP=false
