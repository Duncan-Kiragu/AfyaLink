# Runtime
NODE_ENV=development
APP_ENV=local

# Public URLs
WEB_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000

# Browser-only (apps/web). Never put service-role keys here.
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=

# Supabase (server)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Redis / queues
REDIS_URL=redis://127.0.0.1:6379

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Session TTLs
EPHEMERAL_SESSION_TTL_SECONDS=1800
SESSION_MAX_LIFETIME_SECONDS=14400

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Geo / providers
GEO_PROVIDER=
GEO_API_KEY=

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# USSD
USSD_PROVIDER=
USSD_API_KEY=
USSD_CALLBACK_SECRET=

# Voice
# Leave ELEVENLABS_* empty to use the in-browser mock handset (typed answers).
# Paste a key and agent id locally when you want live Conversational AI.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
VOICE_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Feature flags (true|false)
FEATURE_HEALTH_RECORDS=false
FEATURE_HEALTH_PROFILE=false
FEATURE_WHATSAPP=false
FEATURE_USSD=false
FEATURE_VOICE=true
FEATURE_MCP=false
