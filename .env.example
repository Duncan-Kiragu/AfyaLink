# Runtime
NODE_ENV=development
APP_ENV=local

# Public URLs
WEB_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000

# Browser-only (apps/web). Never put service-role keys here.
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=
# Optional fixed UUID for local records demo (`x-kkd-user-id`). APP_ENV must be local.
VITE_KKD_DEMO_USER_ID=

# Supabase (server)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard label for the service-role key. loadEnv copies this onto SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# Redis / queues
REDIS_URL=redis://127.0.0.1:6379

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Presidio analyzer (PII). Required in staging/production before Claude/webhooks.
PRESIDIO_ANALYZER_URL=http://127.0.0.1:5002

# Session TTLs
EPHEMERAL_SESSION_TTL_SECONDS=1800
SESSION_MAX_LIFETIME_SECONDS=14400

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Geo / providers
GEO_PROVIDER=
GEO_API_KEY=

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# USSD
USSD_PROVIDER=
USSD_API_KEY=
USSD_CALLBACK_SECRET=

# Voice
# Leave ELEVENLABS_* empty to use the in-browser mock handset (typed answers).
# Paste a key and agent id locally when you want live Conversational AI.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
VOICE_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Health records (Duncan / KKD-RECORDS-001)
# RECORD_EXPORT_TTL_SECONDS is an implementation default, not a BRD figure.
RECORD_EXPORT_TTL_SECONDS=900
RECORD_EXPORT_SIGNING_SECRET=local-records-export-dev-only
# local defaults to memory. Set supabase only after the health_records migration is applied.
# KKD_RECORDS_STORE=supabase

# Feature flags (true|false)
FEATURE_HEALTH_RECORDS=true
FEATURE_HEALTH_PROFILE=false
FEATURE_WHATSAPP=false
FEATURE_USSD=false
FEATURE_VOICE=true
FEATURE_MCP=false

# Severity engine (Antonia / KKD-SAFETY-001)
# Executes clinically unreviewed `draft` safety rules and complaint pathways.
# There is no clinical reviewer assigned yet, so every rule KKD ships is `draft` and
# nothing fires with this off. Turning it on means unreviewed clinical content decides
# what a patient is told to do. Keep it false outside local demos: config load refuses
# it when APP_ENV is production, and the process will not start.
FEATURE_SEVERITY_UNREVIEWED_DRAFT_RULES=false
